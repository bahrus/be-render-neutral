{
  "name": "be-render-neutral",
  "version": "0.0.8",
  "description": "Provide base abstract class for different rendering libraries",
  "main": "be-render-neutral.js",
  "scripts": {
    "build": "node emc.mjs > emc.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "files": [
    "*.js",
    "./ts-refs/*"
  ],
  "types": "./types/be-render-neutral/types.d.ts",
  "exports": {
    ".": "./be-render-neutral.js",
    "./emc.js": "./emc.js",
    "./be-render-neutral.js": "./be-render-neutral.js"
  },
  "dependencies": {
    "be-hive": "0.1.15",
    "mount-observer": "0.1.41",
    "roundabout-lib": "0.0.21",
    "trans-render": "0.0.961"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "spa-ssi": "0.0.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-render-neutral.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-render-neutral/issues"
  },
  "homepage": "https://github.com/bahrus/be-render-neutral#readme"
}
